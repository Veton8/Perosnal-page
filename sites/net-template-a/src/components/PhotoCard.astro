---
interface Props {
  caption: string;
  aspect?: 'square' | 'landscape' | 'portrait';
  src?: string;
  alt?: string;
  loading?: 'lazy' | 'eager';
}

const { caption, aspect = 'landscape', src, alt, loading = 'lazy' } = Astro.props;

const aspectClasses = {
  square: 'aspect-square',
  landscape: 'aspect-[4/3]',
  portrait: 'aspect-[3/4]',
};
---

<figure class="group">
  {src ? (
    <img
      src={src}
      alt={alt ?? caption}
      loading={loading}
      class:list={[
        'w-full rounded-xl object-cover',
        aspectClasses[aspect],
      ]}
    />
  ) : (
    <div
      class:list={[
        'w-full rounded-xl overflow-hidden bg-gradient-to-br from-linen via-sand/40 to-terracotta/20',
        aspectClasses[aspect],
      ]}
    >
      <div class="w-full h-full flex items-center justify-center text-warm-gray/40">
        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
        </svg>
      </div>
    </div>
  )}
  <figcaption class="mt-3 font-sourceSans text-sm text-warm-gray text-center">
    {caption}
  </figcaption>
</figure>
