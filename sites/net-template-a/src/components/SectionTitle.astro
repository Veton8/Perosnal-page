---
interface Props {
  title: string;
  subtitle?: string;
  accent?: boolean;
  id?: string;
}

const { title, subtitle, accent = true, id } = Astro.props;
---

<div class="mb-12" id={id}>
  {accent && (
    <div class="w-12 h-1 bg-terracotta rounded-full mb-6"></div>
  )}
  <h2 class="font-playfair text-3xl md:text-4xl font-semibold text-charcoal">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-4 text-lg text-warm-gray leading-relaxed max-w-2xl">
      {subtitle}
    </p>
  )}
</div>
