---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const strengths = [
  { label: 'Customer Success Strategy', color: 'bg-forest-teal/15 text-forest-teal border-forest-teal/30' },
  { label: 'Cloud & SaaS Transformation', color: 'bg-burnt-sienna/15 text-burnt-sienna border-burnt-sienna/30' },
  { label: 'AI-as-a-Service', color: 'bg-marigold/15 text-deep-brown border-marigold/30' },
  { label: 'Go-to-Market Execution', color: 'bg-dusty-rose/15 text-dusty-rose border-dusty-rose/30' },
  { label: 'Revenue Operations', color: 'bg-forest-teal/15 text-forest-teal border-forest-teal/30' },
  { label: 'Global Team Building', color: 'bg-burnt-sienna/15 text-burnt-sienna border-burnt-sienna/30' },
  { label: 'Enterprise Sales', color: 'bg-marigold/15 text-deep-brown border-marigold/30' },
  { label: 'Cross-Cultural Leadership', color: 'bg-dusty-rose/15 text-dusty-rose border-dusty-rose/30' },
  { label: 'Public Speaking', color: 'bg-forest-teal/15 text-forest-teal border-forest-teal/30' },
  { label: 'Community Education', color: 'bg-burnt-sienna/15 text-burnt-sienna border-burnt-sienna/30' },
];

const timeline = [
  { period: '2022 – 2024', place: 'Intel Corporation', role: 'VP & General Manager, Customer Success', description: 'Co-built Intel Tiber SaaS services including Intel Tiber Cloud (AI-based training and inference). Created Intel\'s first $200M ARR revenue stream. Landed Seekr.com and Inflection.AI as customers.', slug: 'intel-customer-success' },
  { period: '2020 – 2022', place: 'Oracle Cloud Infrastructure', role: 'VP, Customer Experience', description: 'Grew the business through customer expansion from ~$200M ARR to >$1.25B ARR. Built global team and landed first two Oracle Dedicated Region deployments.', slug: 'oracle-oci-customer-experience' },
  { period: '2019 – 2020', place: 'Microsoft · Azure', role: 'GM, Customer Success — Azure Data & AI', description: 'Built a team of 500+ global professionals. Customers included Banco Santander, Air Canada, and Bank of America. Achieved ~$1.5B ARR for Data and AI on Azure.', slug: 'microsoft-azure-data-ai' },
  { period: '2015 – 2019', place: 'VMware', role: 'VP, Customer Success / VP, Cloud Services', description: 'Onboarded 200+ new customers on VMware Cloud on AWS. Resolved 200+ customer escalations. Increased NPS by 3+ points. Featured keynote at Gainsight Pulse 2018.', slug: 'vmware-customer-success' },
  { period: '2013 – 2015', place: 'Amazon Web Services', role: 'Global Business Development', description: 'Built and launched Amazon WorkSpaces, WorkDocs, WorkMail. Grew to $200M revenue stream. Landed Johnson & Johnson as the first marquee lighthouse customer — their CIO spoke alongside Andy Jassy at AWS re:Invent.', slug: 'aws-global-business-development' },
  { period: '2001 – 2013', place: 'Microsoft', role: 'Director-level roles', description: 'Twelve years across Business Management, Business Architecture, and Field Enablement. Assignments in Russia, Japan, Saudi Arabia, and Canada. Built incubation businesses around Windows security, management, devices, and productivity workflows.', slug: 'microsoft-director-roles' },
  { period: '1990s', place: 'Earlier career', role: 'HiSoft (Australia), HP, XcelleNet (Sterling Commerce), Vanstar, Georgia-Pacific', description: 'A decade of operating and technology roles across enterprise software and systems, beginning with mobile systems consulting in Canberra, Australia in 1990.', slug: 'early-career-australia-atlanta' },
];

const education = [
  { degree: 'Bachelor of Engineering, Communications Engineering', school: 'University of Canberra, Australia', period: '1986 – 1989' },
  { degree: 'Computer Engineering Studies (4 years)', school: 'Ain Shams University, Cairo', period: '' },
  { degree: 'Microsoft Certified Engineer #62 (globally)', school: 'Plus certifications in Cloud and AI from Microsoft, Oracle Cloud, and AWS', period: '' },
];
---

<BaseLayout
  title="About"
  description="Alaa Badr: three decades building customer success at Microsoft, AWS, Oracle Cloud, and Intel. Cairo-born, Seattle-based. Community educator and published writer."
>
  <!-- Hero (h-card microformat wraps the identity block for IndieWeb) -->
  <section class="bg-gradient-to-b from-peach-cream/60 to-warm-white py-20 md:py-28 border-b border-warm-blush">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center h-card">
        <div>
          <p class="font-caveat text-2xl text-burnt-sienna mb-3">The longer version</p>
          <h1 class="font-fraunces text-4xl md:text-5xl lg:text-6xl text-deep-brown mb-6 leading-tight">
            About <span class="p-name">Alaa Badr</span>
          </h1>
          <p class="p-note text-lg text-warm-umber leading-relaxed">
            GTM executive with nearly three decades building customer success and revenue at <a href="/experience/intel-customer-success/" class="text-forest-teal">Intel</a>, <a href="/experience/oracle-oci-customer-experience/" class="text-forest-teal">Oracle Cloud</a>, <a href="/experience/microsoft-azure-data-ai/" class="text-forest-teal">Microsoft</a>, <a href="/experience/aws-global-business-development/" class="text-forest-teal">AWS</a>, and <a href="/experience/vmware-customer-success/" class="text-forest-teal">VMware</a> &mdash; including ownership of $2B+ in recurring cloud revenue.
          </p>
          <p class="p-note text-lg text-warm-umber leading-relaxed mt-4">
            Cairo-born. <span class="p-locality">Seattle</span>-based. Community educator across <a href="/community/" class="text-forest-teal">five Seattle-area organizations</a>.
          </p>
          <p class="mt-4 text-sm font-lato text-warm-umber/80">
            <a class="u-email text-forest-teal" href="https://www.linkedin.com/in/alaa-badr-" rel="me">LinkedIn</a> &middot;
            <a class="text-forest-teal" href="https://x.com/alaabaadr" rel="me">X / @alaabaadr</a> &middot;
            <a class="u-url text-forest-teal" href="https://alaabadr.net" rel="me">alaabadr.net</a>
          </p>
        </div>
        <div class="relative max-w-[380px] mx-auto md:ml-auto md:mr-0">
          <picture>
            <source srcset="/images/alaa-badr-800.webp" type="image/webp" />
            <img
              src="/images/alaa-badr-800.jpg"
              alt="Alaa Badr"
              width="800"
              height="800"
              class="u-photo aspect-square rounded-3xl object-cover w-full shadow-sm"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          <div class="absolute -bottom-3 -right-3 w-20 h-20 rounded-2xl bg-marigold/15 -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bio -->
  <section class="bg-warm-white py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="space-y-6 text-lg leading-relaxed text-warm-umber">
        <p>
          Alaa Badr is a go-to-market executive with nearly three decades of experience building revenue, customer success, and RevOps organizations at Microsoft, AWS, VMware, Oracle Cloud, and Intel — including ownership of $2B+ in recurring cloud revenue at OCI and global teams spanning 200+ across three continents.
        </p>
        <p>
          His edge is turning complex cloud and AI portfolios into compounding revenue through disciplined execution, data-driven customer motions, and teams built to outperform.
        </p>
        <p>
          His leadership principles are anchored in Customer Obsession, Bias for Action, and hiring and retaining the best people.
        </p>
      </div>

      <div class="mt-12">
        <blockquote class="font-caveat text-3xl md:text-4xl text-center text-forest-teal leading-snug">
          "I lead by the simplest rule in business: obsess over the customer, act like an owner, bet bold, and earn trust one outcome at a time."
        </blockquote>
      </div>
    </div>
  </section>

  <!-- What I Do Best -->
  <section class="bg-pale-sage py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <SectionHeading title="What I Do Best" accent="teal" />
      <p class="text-lg text-warm-umber leading-relaxed max-w-3xl mx-auto text-center mb-10">
        Building and scaling teams. Running technical pre-sales and post-sales POC and delivery metrics. Working with engineering on prioritization of customer roadmaps.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        {strengths.map((s) => (
          <span class={`px-5 py-2.5 rounded-full text-sm font-lato font-bold border ${s.color} transition-transform hover:scale-105`}>
            {s.label}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="bg-peach-cream/50 py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <SectionHeading title="Career Timeline" subtitle="Each role links to its full page" accent="sienna" />

      <div class="space-y-0">
        {timeline.map((item, i) => (
          <div class="relative pl-10 pb-12 last:pb-0 border-l-2 border-warm-blush">
            <div class={`absolute left-0 top-0 w-5 h-5 rounded-full -translate-x-[11px] ${
              ['bg-burnt-sienna', 'bg-forest-teal', 'bg-marigold', 'bg-dusty-rose'][i % 4]
            }`}></div>
            <span class="font-caveat text-xl text-burnt-sienna">{item.period}</span>
            <h3 class="font-fraunces text-xl text-deep-brown mt-1 mb-1">
              <a href={`/experience/${item.slug}/`} class="no-underline hover:text-forest-teal transition-colors">{item.place}</a>
            </h3>
            <p class="font-lato font-bold text-sm text-warm-umber mb-2">{item.role}</p>
            <p class="text-warm-umber leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="bg-warm-white py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <SectionHeading title="Education & Certifications" accent="teal" />

      <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {education.map((e) => (
          <div class="bg-peach-cream/40 rounded-2xl p-6 border border-warm-blush/50">
            <p class="font-fraunces text-lg text-deep-brown mb-1">{e.degree}</p>
            <p class="text-warm-umber text-sm mb-2">{e.school}</p>
            {e.period && <p class="font-caveat text-base text-burnt-sienna">{e.period}</p>}
          </div>
        ))}
      </div>

      <p class="text-center text-warm-umber/80 text-sm mt-8 max-w-2xl mx-auto">
        Leadership training and extended bench leadership programs at Microsoft, VMware, and Intel.
      </p>
    </div>
  </section>

  <!-- Languages -->
  <section class="bg-pale-sage py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <SectionHeading title="Languages" subtitle="Five languages across eight countries" accent="marigold" />

      <div class="max-w-3xl mx-auto text-center">
        <p class="text-lg text-warm-umber leading-relaxed mb-6">
          English, French, Portuguese, Spanish, Arabic — picked up across assignments in <a href="/travel/australia/" class="text-forest-teal">Australia</a>, <a href="/travel/brazil/" class="text-forest-teal">Brazil</a>, <a href="/travel/france/" class="text-forest-teal">France</a>, <a href="/travel/japan/" class="text-forest-teal">Japan</a>, <a href="/travel/saudi-arabia/" class="text-forest-teal">Saudi Arabia</a>, <a href="/travel/canada/" class="text-forest-teal">Canada</a>, and the <a href="/travel/usa/" class="text-forest-teal">United States</a>.
        </p>
        <p class="font-caveat text-2xl text-burnt-sienna">
          English · French · Portuguese · Spanish · Arabic
        </p>
      </div>
    </div>
  </section>

  <!-- Connect -->
  <section class="bg-gradient-to-b from-peach-cream/40 to-warm-white py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <SectionHeading title="Say Hello" subtitle="For speaking, advising, or just a good conversation" accent="teal" />
      <p class="text-lg text-warm-umber leading-relaxed mb-8">
        Open to keynotes, podcast guest spots, advisory roles, and introductions. <a href="https://www.linkedin.com/in/alaa-badr-" class="text-forest-teal">LinkedIn</a> is the best first stop.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="https://www.linkedin.com/in/alaa-badr-" class="inline-block px-6 py-3 bg-forest-teal text-warm-white rounded-full font-lato font-bold text-sm no-underline hover:bg-forest-teal/90 transition-colors">
          Connect on LinkedIn
        </a>
        <a href="https://x.com/alaabaadr" class="inline-block px-6 py-3 bg-burnt-sienna text-warm-white rounded-full font-lato font-bold text-sm no-underline hover:bg-burnt-sienna/90 transition-colors">
          Follow on X
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
