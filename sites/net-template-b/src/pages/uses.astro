---
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = [
  {
    heading: 'Work setup',
    blurb: 'The desk where the calls happen.',
    accent: 'forest-teal',
    items: [
      { name: 'Laptop', detail: 'MacBook Pro — the workhorse for email, docs, video calls, and everything in between.' },
      { name: 'External display', detail: '27" 4K monitor — enough real estate for a Zoom call, a spreadsheet, and a Slack thread without squinting.' },
      { name: 'Keyboard', detail: 'Apple Magic Keyboard — nothing exotic, just reliable.' },
      { name: 'Webcam / mic', detail: 'Built-in MacBook camera for most calls. External mic when recording podcast guest spots or lectures.' },
      { name: 'Headphones', detail: 'Sony WH-1000XM5 — noise-cancelling for focus blocks and flights.' },
      { name: 'Chair', detail: 'Herman Miller Aeron — the most important purchase of the decade. Your back will thank you.' },
    ],
  },
  {
    heading: 'Writing & research',
    blurb: 'How the longer thinking happens.',
    accent: 'burnt-sienna',
    items: [
      { name: 'Notes app', detail: 'Apple Notes for quick capture, with a paper notebook for the ideas that need space to breathe.' },
      { name: 'Reading', detail: 'Kindle for books on the road, physical books at home. A mix of both, always.' },
      { name: 'Calendar', detail: 'Google Calendar — the source of truth for everything.' },
      { name: 'Email client', detail: 'Gmail — simple, fast, searchable.' },
      { name: 'AI tools', detail: 'ChatGPT and Claude for research, drafting, and pressure-testing ideas. Both earning their keep.' },
    ],
  },
  {
    heading: 'Travel',
    blurb: 'For trips across continents and across the bridge.',
    accent: 'dusty-rose',
    items: [
      { name: 'Carry-on', detail: 'A reliable hard-shell roller — the kind that survives Heathrow baggage handlers.' },
      { name: 'Backpack', detail: 'A slim laptop backpack that fits under the seat. Nothing bulky.' },
      { name: 'Adapter / cables', detail: 'Universal travel adapter plus USB-C cables for everything.' },
      { name: 'Noise-cancelling headphones', detail: 'Sony WH-1000XM5 (same as the desk pair — worth owning two).' },
      { name: 'Travel notebook', detail: 'A small Moleskine for ideas that come at 35,000 feet.' },
    ],
  },
  {
    heading: 'Teaching',
    blurb: 'What shows up to the Friday session.',
    accent: 'marigold',
    items: [
      { name: 'Slides tool', detail: 'Google Slides for structured lectures, plain paper and a whiteboard marker for interactive sessions.' },
      { name: 'Reference library', detail: 'A mix of classical texts and contemporary commentary, mostly in Arabic and English.' },
      { name: 'Recording', detail: 'Sessions are occasionally recorded for the community archive.' },
    ],
  },
  {
    heading: 'Kitchen',
    blurb: 'The short list actually in use.',
    accent: 'forest-teal',
    items: [
      { name: 'Knife', detail: 'One good chef\'s knife — Wüsthof Classic. One good knife beats six mediocre ones.' },
      { name: 'Kettle', detail: 'Electric kettle — the tea is sacred, and Egyptian tea doesn\'t make itself.' },
      { name: 'Pan', detail: 'Cast iron skillet — does 80% of the cooking in this house.' },
      { name: 'Coffee setup', detail: 'Pour-over with a Chemex. Seattle coffee standards apply even at home.' },
    ],
  },
  {
    heading: 'Daily carry',
    blurb: 'What travels in the bag every day.',
    accent: 'burnt-sienna',
    items: [
      { name: 'Wallet', detail: 'Slim card holder — cash is rare, cards and phone handle the rest.' },
      { name: 'Pen & notebook', detail: 'A good pen (Pilot G-2) and a small notebook. Some things need to be written by hand.' },
      { name: 'Earbuds', detail: 'AirPods Pro for calls on the go.' },
      { name: 'Bag', detail: 'A clean, minimal backpack that doesn\'t scream "tech bro."' },
    ],
  },
];

const accentClasses: Record<string, string> = {
  'forest-teal': 'text-forest-teal',
  'burnt-sienna': 'text-burnt-sienna',
  'dusty-rose': 'text-dusty-rose',
  'marigold': 'text-deep-brown',
};
const accentBg: Record<string, string> = {
  'forest-teal': 'bg-forest-teal',
  'burnt-sienna': 'bg-burnt-sienna',
  'dusty-rose': 'bg-dusty-rose',
  'marigold': 'bg-marigold',
};
---

<BaseLayout
  title="Uses"
  description="The tools, software, and gear Alaa Badr reaches for every day — from work setup to teaching tools to kitchen essentials. No affiliate links."
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-b from-peach-cream/60 to-warm-white pb-16 md:pb-24 border-b border-warm-blush overflow-hidden">
    <div class="absolute inset-0 opacity-[0.10] pointer-events-none">
      <img src="/images/pages/uses-hero.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" class="w-full h-full object-cover" />
    </div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 pt-20 md:pt-28">
      <p class="font-caveat text-2xl text-burnt-sienna mb-3">What I actually use</p>
      <h1 class="font-fraunces text-4xl md:text-5xl lg:text-6xl text-deep-brown mb-6 leading-tight">
        Uses
      </h1>
      <p class="text-lg text-warm-umber leading-relaxed max-w-2xl">
        A <a href="https://uses.tech" class="text-forest-teal">/uses page</a> in the tradition of Wes Bos. The gear I reach for every day, listed without sponsorship. Updated when something actually changes &mdash; not when a new version ships.
      </p>
    </div>
  </section>

  <section class="bg-warm-white py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-16">
      {groups.map((group) => (
        <div class="grid md:grid-cols-[180px_1fr] gap-6 md:gap-10">
          <div>
            <div class={`w-10 h-1 rounded-full mb-3 ${accentBg[group.accent]}`}></div>
            <h2 class="font-fraunces text-3xl text-deep-brown mb-1">{group.heading}</h2>
            <p class="font-caveat text-lg text-burnt-sienna">{group.blurb}</p>
          </div>
          <dl class="grid sm:grid-cols-2 gap-x-10 gap-y-5">
            {group.items.map((item) => (
              <div class="border-b border-warm-blush/40 pb-3">
                <dt class="font-lato font-bold text-deep-brown text-sm">{item.name}</dt>
                <dd class="text-warm-umber text-sm mt-0.5">{item.detail}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}

      <div class="max-w-prose mx-auto pt-10 border-t border-warm-blush/50">
        <p class="text-warm-umber text-sm">
          No affiliate links. No sponsored placements. If something gets replaced, the old version disappears from the page. Inspired by Wes Bos's <a href="https://uses.tech/" class="text-forest-teal">uses.tech</a> directory.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
