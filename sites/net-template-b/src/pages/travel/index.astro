---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const all = await getCollection('travel', ({ data }) => !data.draft);
const entries = all.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Passport Stamps"
  description="From Cairo to Canberra to Seattle — the countries and cities that shaped Alaa Badr's three-decade global technology career."
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-b from-peach-cream/60 to-warm-white pb-16 md:pb-24 border-b border-warm-blush overflow-hidden">
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 pt-20 md:pt-28">
      <p class="font-caveat text-2xl text-burnt-sienna mb-3">Five languages, ten countries</p>
      <h1 class="font-fraunces text-4xl md:text-5xl lg:text-6xl text-deep-brown mb-6 leading-tight">
        Passport Stamps
      </h1>
      <p class="text-lg text-warm-umber leading-relaxed max-w-2xl">
        The places that have shaped how I work, lead, and see the world. From Cairo to Canberra, Riyadh to Seoul, Toronto to Tokyo — each country left a mark on the career and the person.
      </p>
    </div>
  </section>

  <section class="bg-warm-white py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <ul class="grid sm:grid-cols-2 gap-4">
        {entries.map((entry) => (
          <li>
            <a
              href={`/travel/${entry.id}/`}
              class="block h-full bg-warm-white rounded-2xl p-6 border border-warm-blush/50 hover:shadow-sm hover:border-burnt-sienna/40 transition-all no-underline"
            >
              <p class="font-caveat text-xl text-burnt-sienna mb-1">{entry.data.country}</p>
              <h2 class="font-fraunces text-xl text-deep-brown mb-2 leading-snug">{entry.data.title}</h2>
              <p class="text-warm-umber text-sm leading-relaxed">{entry.data.description}</p>
              {entry.data.years && (
                <p class="font-lato text-xs text-warm-umber/60 mt-3">{entry.data.years}</p>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
