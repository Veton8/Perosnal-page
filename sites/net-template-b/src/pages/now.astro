---
import BaseLayout from '../layouts/BaseLayout.astro';

// Update this date whenever you revise the page — that's the whole point.
const lastUpdated = new Date('2026-04-27');
const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const blocks = [
  {
    icon: '◐',
    title: 'Work',
    accent: 'forest-teal',
    body: "Most recently VP & GM of Customer Success at <a href=\"/experience/intel-customer-success/\" class=\"text-forest-teal underline\">Intel</a> (2022–2024), focused on AI-as-a-Service and Confidential Computing. Currently evaluating what comes next — advisory, board, or the next operating role — and spending time sharpening the thinking on where customer success goes in the AI era.",
  },
  {
    icon: '◑',
    title: 'Teaching',
    accent: 'burnt-sienna',
    body: "Every week, teaching at <a href=\"/community/maps-redmond/\" class=\"text-burnt-sienna underline\">MAPS Redmond</a>, the <a href=\"/community/islamic-center-bothell/\" class=\"text-burnt-sienna underline\">Islamic Center of Bothell</a> (Weekly Knowledge Quest seerah class), the <a href=\"/community/muslim-association-kirkland/\" class=\"text-burnt-sienna underline\">Muslim Association of Kirkland</a> (story of creation lecture series), and <a href=\"/community/maps-seattle/\" class=\"text-burnt-sienna underline\">MAPS Seattle</a> (bi-weekly Tafseer on Surah Al-Naml).",
  },
  {
    icon: '◒',
    title: 'Speaking',
    accent: 'dusty-rose',
    body: "Open to keynotes, panels, and podcast guest spots on customer success, AI-as-a-Service, cloud transformation, and leading cross-cultural teams. Most recent: <a href=\"/media/bellevue-rotary-2024/\" class=\"text-dusty-rose underline\">Bellevue Rotary, January 2024 — Evolution of Customer Success with AI Capability</a>.",
  },
  {
    icon: '◓',
    title: 'Writing',
    accent: 'marigold',
    body: "Published opinion contributor at The Seattle Times on Middle East affairs and civic engagement. Writing more longform now — the intersection of technology leadership, faith, and multi-cultural leadership.",
  },
  {
    icon: '◐',
    title: 'Learning',
    accent: 'forest-teal',
    body: "AI-as-a-Service is the through-line right now — where the value actually accrues, how customer success shifts when software becomes agentive, and how trust gets built when the product changes itself every week.",
  },
  {
    icon: '◑',
    title: 'Community',
    accent: 'burnt-sienna',
    body: "Active with the <a href=\"/community/bellevue-rotary/\" class=\"text-burnt-sienna underline\">Bellevue Rotary Club</a>. Mentoring younger professionals navigating global careers and cross-cultural leadership. If you're early-career and want a thirty-minute conversation, the door is open — LinkedIn is the best place to ask.",
  },
];

const accentClasses: Record<string, string> = {
  'forest-teal': 'text-forest-teal bg-forest-teal/10 border-forest-teal/30',
  'burnt-sienna': 'text-burnt-sienna bg-burnt-sienna/10 border-burnt-sienna/30',
  'dusty-rose': 'text-dusty-rose bg-dusty-rose/10 border-dusty-rose/30',
  'marigold': 'text-deep-brown bg-marigold/15 border-marigold/30',
};
---

<BaseLayout
  title="Now"
  description="What Alaa Badr is focused on right now — work, reading, projects, and life in the present tense."
>
  <!-- Hero with image -->
  <section class="relative bg-gradient-to-b from-peach-cream/60 to-warm-white pb-16 md:pb-24 border-b border-warm-blush overflow-hidden">
    <div class="absolute inset-0 opacity-[0.12] pointer-events-none">
      <img src="/images/pages/now-hero.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" class="w-full h-full object-cover" />
    </div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 pt-20 md:pt-28">
      <p class="font-caveat text-2xl text-burnt-sienna mb-3">A letter to future visitors</p>
      <h1 class="font-fraunces text-4xl md:text-5xl lg:text-6xl text-deep-brown mb-6 leading-tight">
        What I'm doing <span class="text-forest-teal">now</span>
      </h1>
      <p class="text-lg text-warm-umber leading-relaxed max-w-2xl">
        A snapshot of where my attention is going right now &mdash; the work, the teaching, the reading, the people. Short, honest, and updated when something meaningful changes.
      </p>
      <p class="mt-6 text-sm font-lato text-warm-umber/80">
        Last updated <time datetime={lastUpdated.toISOString()}>{dateFmt.format(lastUpdated)}</time> &middot; from Seattle, WA
      </p>
    </div>
  </section>

  <!-- Now blocks -->
  <section class="bg-warm-white py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid md:grid-cols-2 gap-6 md:gap-8">
        {blocks.map((b) => (
          <article class={`rounded-3xl p-7 md:p-8 border ${accentClasses[b.accent]} bg-opacity-30 backdrop-blur-sm`}>
            <div class="flex items-center gap-3 mb-3">
              <span class={`text-3xl ${accentClasses[b.accent].split(' ')[0]}`}>{b.icon}</span>
              <h2 class="font-fraunces text-2xl text-deep-brown">{b.title}</h2>
            </div>
            <p class="text-warm-umber leading-relaxed" set:html={b.body}></p>
          </article>
        ))}
      </div>

      <div class="max-w-prose mx-auto mt-16">
        <blockquote class="font-caveat text-3xl text-burnt-sienna border-l-4 border-burnt-sienna/30 pl-5">
          This page is written like a letter to a distant friend. If you're reading it, consider yourself a distant friend.
        </blockquote>
      </div>
    </div>
  </section>
</BaseLayout>
