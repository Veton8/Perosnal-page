---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const companies = [
  { slug: 'intel-customer-success', name: 'Intel', role: 'VP & GM, Customer Success', period: '2022 – 2024', accent: 'forest-teal' as const, note: 'Co-built Intel Tiber SaaS / Tiber Cloud. Created Intel\'s first $200M ARR revenue stream. Landed Seekr.com and Inflection.AI.' },
  { slug: 'oracle-oci-customer-experience', name: 'Oracle Cloud Infrastructure', role: 'VP, Customer Experience', period: '2020 – 2022', accent: 'burnt-sienna' as const, note: 'Grew the business from ~$200M to >$1.25B ARR. Landed the first two Oracle Dedicated Region deployments.' },
  { slug: 'microsoft-azure-data-ai', name: 'Microsoft (Azure)', role: 'GM, Customer Success · Azure Data & AI', period: '2019 – 2020', accent: 'marigold' as const, note: 'Built a 500+ global team. ~$1.5B ARR for Azure Data & AI. Customers: Banco Santander, Air Canada, Bank of America.' },
  { slug: 'vmware-customer-success', name: 'VMware', role: 'VP, Customer Success / Cloud Services', period: '2015 – 2019', accent: 'dusty-rose' as const, note: 'Onboarded 200+ customers on VMware Cloud on AWS. NPS up 3+ points. Featured keynote at Gainsight Pulse 2018.' },
  { slug: 'aws-global-business-development', name: 'Amazon Web Services', role: 'Global Business Development', period: '2013 – 2015', accent: 'forest-teal' as const, note: 'Built and launched Amazon WorkSpaces, WorkDocs, WorkMail. $200M revenue stream. Landed J&J as lighthouse customer.' },
  { slug: 'microsoft-director-roles', name: 'Microsoft', role: 'Director-level roles', period: '2001 – 2013', accent: 'burnt-sienna' as const, note: 'Twelve years across Russia, Japan, Saudi Arabia, and Canada. Ran sales excellence for Microsoft Japan ($1B+ subsidiary).' },
  { slug: 'early-career-australia-atlanta', name: 'Earlier career', role: 'HiSoft, HP, XcelleNet, Vanstar, Georgia-Pacific', period: '1990s', accent: 'dusty-rose' as const, note: 'Started in Canberra, Australia in 1990. A decade of operating roles across enterprise software and systems.' },
];

const speaking = [
  { slug: 'ai-summit-cairo-university', date: '2025', venue: 'AI Summit · Cairo University', title: 'Customer Success in the AI Era — keynote and panel', accent: 'marigold' },
  { slug: 'bellevue-rotary-2024', date: 'Jan 2024', venue: 'Bellevue Rotary Club', title: 'Evolution of Customer Success with AI Capability', accent: 'forest-teal' },
  { slug: 'gainsight-pulse-2018', date: '2018', venue: 'Gainsight Pulse · San Mateo', title: 'Delivering Customer Outcomes at VMware', accent: 'burnt-sienna' },
  { slug: 'gainsight-cs-podcast', date: 'Podcast', venue: 'Gainsight Customer Success Podcast', title: 'Customer engagements and ARR growth', accent: 'marigold' },
  { slug: 'techbullion-feature', date: 'Feature', venue: 'TechBullion', title: 'Profile on technology innovation and building global teams', accent: 'dusty-rose' },
  { slug: 'seattle-times-op-ed', date: 'Op-Ed', venue: 'The Seattle Times', title: 'Published opinion contributor — Middle East affairs & civic engagement', accent: 'forest-teal' },
];

// PLACEHOLDER: Replace with real testimonials when client supplies them.
const testimonials = [
  {
    quote: "Alaa is one of those rare executives who can see the entire board — the customer, the product, the team, the market — and move all the pieces at once. He built our customer success organization from a support function into a growth engine.",
    name: "Sarah Mitchell",
    role: "VP of Engineering (former colleague at Oracle Cloud Infrastructure)",
    accent: 'forest-teal',
  },
  {
    quote: "I've worked with a lot of leaders who talk about customer obsession. Alaa is one of the few who actually lives it. He'd fly to a customer site on a Friday, run a workshop on Saturday, and be back teaching at his community center on Sunday.",
    name: "James Chen",
    role: "Senior Director of Customer Success (former direct report at VMware)",
    accent: 'burnt-sienna',
  },
  {
    quote: "When we were building the WorkSpaces business at AWS, Alaa was the person who could walk into a Fortune 500 CIO's office and earn their trust in a single meeting. He doesn't sell — he solves. That's why J&J became our lighthouse customer.",
    name: "David Okonkwo",
    role: "Principal Business Development Manager (former colleague at AWS)",
    accent: 'marigold',
  },
  {
    quote: "Alaa brings something you don't find in most tech executives — genuine warmth. He's as comfortable leading a team through a $1B pipeline review as he is teaching a Sunday class at the Islamic Center. Both sides are the real Alaa.",
    name: "Fatima Al-Rashid",
    role: "Community Leader & Educator (MAPS Redmond)",
    accent: 'dusty-rose',
  },
];

const accentBg: Record<string, string> = {
  'forest-teal': 'bg-forest-teal',
  'burnt-sienna': 'bg-burnt-sienna',
  'marigold': 'bg-marigold',
  'dusty-rose': 'bg-dusty-rose',
};

const accentText: Record<string, string> = {
  'forest-teal': 'text-forest-teal',
  'burnt-sienna': 'text-burnt-sienna',
  'marigold': 'text-deep-brown',
  'dusty-rose': 'text-dusty-rose',
};
---

<BaseLayout
  title="GTM Executive · Customer Success Leader"
  description="Alaa Badr is a go-to-market executive who has scaled customer success and revenue at Microsoft, AWS, VMware, Oracle Cloud, and Intel. Seattle-based, Cairo-born."
>
  <!-- ==================== HERO ==================== -->
  <section class="relative min-h-screen flex items-center bg-gradient-to-b from-peach-cream/60 via-warm-white to-warm-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-24 md:py-32 w-full">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div class="h-card">
          <p class="font-caveat text-2xl text-burnt-sienna mb-4">
            Technical Leader · Customer Success & Sales GTM · AI Delivery
          </p>
          <h1 class="font-fraunces text-5xl md:text-6xl lg:text-7xl text-deep-brown mb-6 leading-[1.1]">
            Hello, I'm <span class="p-name fraunces-kinetic text-forest-teal">Alaa</span>
          </h1>
          <p class="p-note text-lg md:text-xl text-warm-umber leading-relaxed max-w-lg mb-6">
            Builds world-class Customer Success and GTM organizations that turn enterprise cloud and AI into compounding revenue &mdash; proven across Microsoft, AWS, VMware, Oracle ($2B ARR), and Intel.
          </p>
          <p class="text-sm font-lato text-warm-umber/80 mb-8">
            <span class="p-locality">Seattle, WA</span> · Originally from Cairo &middot; English, French, Portuguese, Spanish, Arabic
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="#career" class="inline-block px-6 py-3 bg-forest-teal text-warm-white rounded-full font-lato font-bold text-sm no-underline hover:bg-forest-teal/90 transition-colors">
              View Experience
            </a>
            <a href="#connect" class="inline-block px-6 py-3 bg-transparent border-2 border-burnt-sienna text-burnt-sienna rounded-full font-lato font-bold text-sm no-underline hover:bg-burnt-sienna hover:text-warm-white transition-colors">
              Let's Connect
            </a>
          </div>
        </div>

        <!-- Photo -->
        <div class="relative max-w-[420px] mx-auto md:ml-auto md:mr-0">
          <picture>
            <source srcset="/images/alaa-badr-800.webp" type="image/webp" />
            <img
              src="/images/alaa-badr-800.jpg"
              alt="Alaa Badr"
              width="800"
              height="800"
              class="u-photo aspect-square rounded-3xl object-cover w-full shadow-lg"
              fetchpriority="high"
              loading="eager"
              decoding="async"
            />
          </picture>
          <div class="absolute -bottom-4 -left-4 w-24 h-24 rounded-2xl bg-marigold/20 -z-10"></div>
          <div class="absolute -top-4 -right-4 w-32 h-32 rounded-full bg-dusty-rose/15 -z-10"></div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-warm-umber/50">
      <span class="font-caveat text-sm">Scroll to explore</span>
      <div class="w-5 h-8 border-2 border-warm-umber/30 rounded-full flex justify-center pt-1.5">
        <div class="w-1 h-2 bg-warm-umber/40 rounded-full animate-bounce"></div>
      </div>
    </div>
  </section>

  <!-- ==================== MY STORY ==================== -->
  <section class="bg-warm-white py-24 md:py-32" id="story">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionHeading title="My Story" subtitle="Cairo to Seattle, by way of a lot of companies" accent="sienna" />

      <div class="max-w-3xl mx-auto space-y-6 text-lg leading-relaxed text-warm-umber">
        <p>
          I was born and raised in Cairo, the son of an Egyptian diplomat who served as Ambassador to Australia and Jordan, Consul General in Rio de Janeiro, and held postings in Washington DC, Damascus, and Beirut. I grew up across continents &mdash; <a href="/travel/brazil/" class="text-forest-teal">Brazil</a> in the 1970s, <a href="/travel/egypt/" class="text-forest-teal">Egypt</a>, <a href="/travel/australia/" class="text-forest-teal">Australia</a> in my twenties &mdash; before the US pulled me west.
        </p>
        <p>
          I studied Computer Engineering at Ain Shams University in Cairo, then earned a Bachelor of Engineering in Communications from the University of Canberra in Australia, where I launched my technology career in the early 1990s.
        </p>
        <p>
          Three decades later, I've built and scaled customer success and go-to-market organizations at <a href="/experience/microsoft-director-roles/" class="text-forest-teal">Microsoft</a>, <a href="/experience/aws-global-business-development/" class="text-forest-teal">AWS</a>, <a href="/experience/vmware-customer-success/" class="text-forest-teal">VMware</a>, <a href="/experience/oracle-oci-customer-experience/" class="text-forest-teal">Oracle Cloud</a>, and <a href="/experience/intel-customer-success/" class="text-forest-teal">Intel</a>. Along the way I've owned $2B+ in recurring cloud revenue, built global teams spanning 200+ across three continents, and learned that the best technology careers are built the same way communities are &mdash; one honest conversation at a time.
        </p>
        <p>
          Today I live in <a href="/travel/usa/" class="text-forest-teal">Seattle</a> with my wife and three daughters. Outside of work, I teach weekly at the <a href="/community/maps-redmond/" class="text-forest-teal">Muslim Association of Puget Sound</a>, the <a href="/community/islamic-center-bothell/" class="text-forest-teal">Islamic Center of Bothell</a>, the <a href="/community/muslim-association-kirkland/" class="text-forest-teal">Muslim Association of Kirkland</a>, and <a href="/community/maps-seattle/" class="text-forest-teal">MAPS Seattle</a>. I'm also a member of the <a href="/community/bellevue-rotary/" class="text-forest-teal">Bellevue Rotary Club</a>. The tech career gives me a platform; the teaching keeps me honest.
        </p>
      </div>

      <!-- Pull quote -->
      <div class="max-w-3xl mx-auto mt-16">
        <blockquote class="font-caveat text-3xl md:text-4xl text-center text-warm-umber leading-snug">
          "Enterprise technology wins when the customer does &mdash; everything else is theater."
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ==================== CAREER ==================== -->
  <section class="bg-peach-cream/50 py-24 md:py-32" id="career">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionHeading title="The Work" subtitle="Thirty years of customer success, cloud, and SaaS at scale" accent="teal" />

      <p class="text-lg text-warm-umber leading-relaxed max-w-3xl mx-auto text-center mb-16">
        Senior technology leadership across the companies that shape how the world computes. Each role has its own page with the numbers, the customers, and what we actually built.
      </p>

      <div class="space-y-4 max-w-4xl mx-auto">
        {companies.map((c) => (
          <a href={`/experience/${c.slug}/`} class="block bg-warm-white rounded-2xl p-6 md:p-7 border border-warm-blush/50 hover:shadow-sm transition-all no-underline">
            <div class="flex flex-wrap items-start gap-4">
              <div class={`w-1 self-stretch rounded-full ${accentBg[c.accent]}`}></div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-1">
                  <h3 class="font-fraunces text-xl md:text-2xl text-deep-brown">{c.name}</h3>
                  <span class="font-lato text-sm text-warm-umber/70">{c.period}</span>
                </div>
                <p class={`font-lato font-bold text-sm ${accentText[c.accent]} mb-2`}>{c.role}</p>
                <p class="text-warm-umber text-sm leading-relaxed">{c.note}</p>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/experience/" class="inline-block font-lato text-sm font-bold text-forest-teal no-underline hover:underline">
          See the full career &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== COMMUNITY & FAITH ==================== -->
  <section class="bg-pale-sage py-24 md:py-32" id="community">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionHeading title="Community & Faith" subtitle="The work that gives everything else meaning" accent="rose" />

      <div class="max-w-4xl mx-auto">
        <div class="space-y-6 text-lg leading-relaxed text-warm-umber">
          <p>
            Every week I teach. At <a href="/community/maps-redmond/" class="text-forest-teal">MAPS Redmond</a>, I lead the Muslim Experience Halaqa and contribute to Friday lectures and khutbas. At the <a href="/community/islamic-center-bothell/" class="text-forest-teal">Islamic Center of Bothell</a>, I run the Weekly Knowledge Quest &mdash; a seerah class that's been going for over two years. At the <a href="/community/muslim-association-kirkland/" class="text-forest-teal">Muslim Association of Kirkland</a>, I give a weekly lecture on the story of creation. At <a href="/community/maps-seattle/" class="text-forest-teal">MAPS Seattle</a>, I lead a bi-weekly Tafseer session on Surah Al-Naml. I'm also a member of the <a href="/community/bellevue-rotary/" class="text-forest-teal">Bellevue Rotary Club</a>.
          </p>
          <p>
            These aren't side projects. The tech career gives me a platform and a paycheck; the teaching keeps me humble and keeps me learning.
          </p>
        </div>

        <!-- Community orgs strip -->
        <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
          <a href="/community/maps-redmond/" class="bg-warm-white rounded-2xl p-5 border border-warm-blush/50 text-center no-underline hover:shadow-sm transition-all">
            <p class="font-fraunces text-base text-deep-brown mb-1">MAPS Redmond</p>
            <p class="font-caveat text-base text-burnt-sienna">Muslim Experience Halaqa</p>
          </a>
          <a href="/community/islamic-center-bothell/" class="bg-warm-white rounded-2xl p-5 border border-warm-blush/50 text-center no-underline hover:shadow-sm transition-all">
            <p class="font-fraunces text-base text-deep-brown mb-1">ICB Bothell</p>
            <p class="font-caveat text-base text-forest-teal">Weekly Knowledge Quest</p>
          </a>
          <a href="/community/muslim-association-kirkland/" class="bg-warm-white rounded-2xl p-5 border border-warm-blush/50 text-center no-underline hover:shadow-sm transition-all">
            <p class="font-fraunces text-base text-deep-brown mb-1">MA Kirkland</p>
            <p class="font-caveat text-base text-marigold">Story of creation</p>
          </a>
          <a href="/community/maps-seattle/" class="bg-warm-white rounded-2xl p-5 border border-warm-blush/50 text-center no-underline hover:shadow-sm transition-all">
            <p class="font-fraunces text-base text-deep-brown mb-1">MAPS Seattle</p>
            <p class="font-caveat text-base text-dusty-rose">Surah Al-Naml Tafseer</p>
          </a>
          <a href="/community/bellevue-rotary/" class="bg-warm-white rounded-2xl p-5 border border-warm-blush/50 text-center no-underline hover:shadow-sm transition-all">
            <p class="font-fraunces text-base text-deep-brown mb-1">Bellevue Rotary</p>
            <p class="font-caveat text-base text-burnt-sienna">Service above self</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== TESTIMONIALS ==================== -->
  <!-- PLACEHOLDER: Replace with real testimonials when client supplies them. -->
  <section class="bg-warm-white py-24 md:py-32" id="testimonials">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionHeading title="What People Say" subtitle="From colleagues, direct reports, and community" accent="sienna" />

      <div class="grid md:grid-cols-2 gap-6 md:gap-8 max-w-5xl mx-auto">
        {testimonials.map((t) => (
          <figure class={`rounded-3xl p-7 md:p-8 border ${accentBg[t.accent]}/20 bg-peach-cream/30`}>
            <blockquote class="text-warm-umber leading-relaxed text-base md:text-lg mb-5">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <figcaption>
              <p class={`font-fraunces text-lg ${accentText[t.accent]}`}>{t.name}</p>
              <p class="font-lato text-xs text-warm-umber/70 mt-0.5">{t.role}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== SPEAKING & MEDIA ==================== -->
  <section class="bg-peach-cream/30 py-24 md:py-32" id="speaking">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionHeading title="Speaking & Writing" subtitle="Where the ideas have been sharpened in public" accent="marigold" />

      <div class="max-w-4xl mx-auto">
        <ul class="space-y-6">
          {speaking.map((item) => (
            <li class="group border-b border-warm-blush/50 pb-6 last:border-none">
              <a href={`/media/${item.slug}/`} class="block no-underline hover:text-burnt-sienna transition-colors">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-2">
                  <span class={`px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wide ${accentBg[item.accent as keyof typeof accentBg]}/15 ${accentText[item.accent as keyof typeof accentText]}`}>
                    {item.date}
                  </span>
                  <span class="font-lato text-sm text-warm-umber/70">{item.venue}</span>
                </div>
                <h3 class="font-fraunces text-xl md:text-2xl text-deep-brown leading-snug">{item.title}</h3>
              </a>
            </li>
          ))}
        </ul>

        <div class="text-center mt-10">
          <a href="/media/" class="inline-block font-lato text-sm font-bold text-forest-teal no-underline hover:underline">
            See all speaking & media &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CONNECT ==================== -->
  <section class="bg-gradient-to-b from-peach-cream/50 to-pale-sage py-24 md:py-32" id="connect">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <SectionHeading title="Let's Connect" subtitle="The kettle is always on" accent="teal" />

      <p class="text-lg text-warm-umber leading-relaxed max-w-2xl mx-auto mb-10">
        Whether you want to talk customer success, cloud strategy, community work, or the subtle differences between Cairo and Seattle coffee &mdash; my inbox and my LinkedIn are both open.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 mb-10">
        <a href="https://www.linkedin.com/in/alaa-badr-" class="inline-block px-6 py-3 bg-forest-teal text-warm-white rounded-full font-lato font-bold text-sm no-underline hover:bg-forest-teal/90 transition-colors">
          Connect on LinkedIn
        </a>
        <a href="https://x.com/alaabaadr" class="inline-block px-6 py-3 bg-burnt-sienna text-warm-white rounded-full font-lato font-bold text-sm no-underline hover:bg-burnt-sienna/90 transition-colors">
          Follow on X
        </a>
        <a href="/about/" class="inline-block px-6 py-3 bg-deep-brown text-warm-white rounded-full font-lato font-bold text-sm no-underline hover:bg-deep-brown/80 transition-colors">
          Read the Full Bio
        </a>
      </div>

      <p class="font-caveat text-2xl text-warm-umber">
        Thanks for scrolling all the way down. See you out there.
      </p>
    </div>
  </section>
</BaseLayout>
