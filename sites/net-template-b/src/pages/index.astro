---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const companies = [
  { name: 'Intel', role: 'VP & GM, Customer Success', period: '2022 – 2024', accent: 'forest-teal' as const, note: 'AI-as-a-Service, Confidential Computing, 200+ person org.' },
  { name: 'Oracle Cloud Infrastructure', role: 'VP, Customer Experience', period: '2020 – 2022', accent: 'burnt-sienna' as const, note: '~600 engineers. Contributed to 55% YoY OCI revenue growth.' },
  { name: 'Microsoft (Azure)', role: 'GM, Customer Success · Azure Data & AI', period: '2019 – 2020', accent: 'marigold' as const, note: 'Top 200 global accounts — Walmart, Citi, Home Depot, Pearson.' },
  { name: 'VMware', role: 'VP, Customer Success / Cloud Services', period: '2015 – 2019', accent: 'dusty-rose' as const, note: 'Featured keynote at Gainsight Pulse 2018.' },
  { name: 'Amazon Web Services', role: 'Global Business Development', period: '2013 – 2015', accent: 'forest-teal' as const, note: 'WorkSpaces, WorkDocs, WorkMail — 200% MoM MRR growth.' },
  { name: 'Microsoft', role: 'Director-level roles', period: '2001 – 2013', accent: 'burnt-sienna' as const, note: 'Assignments across Russia, Japan, and Saudi Arabia.' },
];

const speaking = [
  { date: 'Jan 2024', venue: 'Bellevue Rotary Club', title: 'Evolution of Customer Success with AI Capability', accent: 'forest-teal' },
  { date: '2018', venue: 'Gainsight Pulse · San Mateo', title: 'How a Customer Success Revolution is Driving SaaS at VMware', accent: 'burnt-sienna' },
  { date: 'Podcast', venue: 'Gainsight Customer Success Podcast', title: 'Creating customer insights at scale — with Allison Pickens', accent: 'marigold' },
  { date: 'Feature', venue: 'TechBullion', title: 'Profile on technology innovation and building global teams', accent: 'dusty-rose' },
  { date: 'Opinion', venue: 'The Seattle Times', title: 'Published opinion contributor — Middle East affairs & civic engagement', accent: 'forest-teal' },
];

const accentBg: Record<string, string> = {
  'forest-teal': 'bg-forest-teal',
  'burnt-sienna': 'bg-burnt-sienna',
  'marigold': 'bg-marigold',
  'dusty-rose': 'bg-dusty-rose',
};

const accentText: Record<string, string> = {
  'forest-teal': 'text-forest-teal',
  'burnt-sienna': 'text-burnt-sienna',
  'marigold': 'text-deep-brown',
  'dusty-rose': 'text-dusty-rose',
};
---

<BaseLayout
  title="Home"
  description="The personal site of Alaa Badr -- senior technology executive, community educator, and lifelong learner. Cairo roots, Seattle home."
>
  <!-- ==================== HERO ==================== -->
  <section class="relative min-h-screen flex items-center bg-gradient-to-b from-peach-cream/60 via-warm-white to-warm-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-24 md:py-32 w-full">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div class="h-card">
          <p class="font-caveat text-2xl text-burnt-sienna mb-4">
            Technology executive · Community educator · Lifelong learner
          </p>
          <h1 class="font-fraunces text-5xl md:text-6xl lg:text-7xl text-deep-brown mb-6 leading-[1.1]">
            Hello, I'm <span class="p-name fraunces-kinetic text-forest-teal">Alaa</span>
          </h1>
          <p class="p-note text-lg md:text-xl text-warm-umber leading-relaxed max-w-lg mb-8">
            Thirty years building customer success and cloud organizations at the world's largest technology companies &mdash; and the rest of the week, teaching, mentoring, and writing in the community I call home.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="#story" class="inline-block px-6 py-3 bg-forest-teal text-warm-white rounded-full font-lato font-bold text-sm no-underline hover:bg-forest-teal/90 transition-colors">
              Read My Story
            </a>
            <a href="#career" class="inline-block px-6 py-3 bg-transparent border-2 border-burnt-sienna text-burnt-sienna rounded-full font-lato font-bold text-sm no-underline hover:bg-burnt-sienna hover:text-warm-white transition-colors">
              See the Work
            </a>
          </div>
        </div>

        <!-- Photo -->
        <div class="relative max-w-[420px] mx-auto md:ml-auto md:mr-0">
          <picture>
            <source srcset="/images/alaa-badr-800.webp" type="image/webp" />
            <img
              src="/images/alaa-badr-800.jpg"
              alt="Alaa Badr"
              width="800"
              height="800"
              class="u-photo aspect-square rounded-3xl object-cover w-full shadow-lg"
              fetchpriority="high"
              loading="eager"
              decoding="async"
            />
          </picture>
          <div class="absolute -bottom-4 -left-4 w-24 h-24 rounded-2xl bg-marigold/20 -z-10"></div>
          <div class="absolute -top-4 -right-4 w-32 h-32 rounded-full bg-dusty-rose/15 -z-10"></div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-warm-umber/50">
      <span class="font-caveat text-sm">Scroll to explore</span>
      <div class="w-5 h-8 border-2 border-warm-umber/30 rounded-full flex justify-center pt-1.5">
        <div class="w-1 h-2 bg-warm-umber/40 rounded-full animate-bounce"></div>
      </div>
    </div>
  </section>

  <!-- ==================== MY STORY ==================== -->
  <section class="bg-warm-white py-24 md:py-32" id="story">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionHeading title="My Story" subtitle="Cairo to Seattle, by way of a lot of companies" accent="sienna" />

      <!-- Cairo block -->
      <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center mb-20">
        <div class="space-y-6 text-lg leading-relaxed text-warm-umber">
          <p>
            I was born and raised in Cairo, studied engineering at Ain Shams University, and then took the long way around &mdash; a Bachelor of Engineering in Communications from the University of Canberra in the late 1980s, followed by consulting work in Australia before the US pulled me west.
          </p>
          <p>
            Growing up in Egypt taught me what hospitality looks like when it's the default setting, not a policy. It taught me to hold warmth and ambition in the same hand. Those two instincts have shaped every team I've built since.
          </p>
        </div>
        <img src="/images/story/cairo-childhood.jpg" alt="Cairo" loading="lazy" decoding="async" class="rounded-2xl aspect-[4/3] object-cover w-full shadow-sm" />
      </div>

      <!-- Pull quote -->
      <div class="max-w-3xl mx-auto mb-20">
        <blockquote class="font-caveat text-3xl md:text-4xl text-center text-warm-umber leading-snug">
          "The best technology careers are built the same way communities are &mdash; one honest conversation at a time."
        </blockquote>
      </div>

      <!-- Seattle block -->
      <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
        <img src="/images/story/seattle-life.jpg" alt="Seattle" loading="lazy" decoding="async" class="order-2 md:order-1 rounded-2xl aspect-[4/3] object-cover w-full shadow-sm" />
        <div class="order-1 md:order-2 space-y-6 text-lg leading-relaxed text-warm-umber">
          <p>
            Today I live in the Seattle area. Over three decades in the industry, I've led customer success and cloud services organizations at Intel, Oracle Cloud Infrastructure, Microsoft (twice), Amazon Web Services, and VMware. Along the way I've lived and worked across five countries and learned to operate in six languages.
          </p>
          <p>
            Outside of work, the week is built around teaching. I run a weekly educational series at the Islamic Center of Bothell, teach at the Muslim Association of Puget Sound in Redmond, and stay involved with the Bellevue Rotary Club. That work keeps me grounded &mdash; and honest.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CAREER ==================== -->
  <section class="bg-peach-cream/50 py-24 md:py-32" id="career">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionHeading title="The Work" subtitle="Thirty years of customer success, cloud, and SaaS at scale" accent="teal" />

      <p class="text-lg text-warm-umber leading-relaxed max-w-3xl mx-auto text-center mb-16">
        Senior technology leadership across the companies that shape how the world computes. A focus on building global customer success organizations, accelerating cloud and SaaS adoption, and turning customer outcomes into business growth.
      </p>

      <div class="space-y-4 max-w-4xl mx-auto">
        {companies.map((c) => (
          <article class="bg-warm-white rounded-2xl p-6 md:p-7 border border-warm-blush/50 hover:shadow-sm transition-all">
            <div class="flex flex-wrap items-start gap-4">
              <div class={`w-1 self-stretch rounded-full ${accentBg[c.accent]}`}></div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-1">
                  <h3 class="font-fraunces text-xl md:text-2xl text-deep-brown">{c.name}</h3>
                  <span class="font-lato text-sm text-warm-umber/70">{c.period}</span>
                </div>
                <p class={`font-lato font-bold text-sm ${accentText[c.accent]} mb-2`}>{c.role}</p>
                <p class="text-warm-umber text-sm leading-relaxed">{c.note}</p>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/about/" class="inline-block font-lato text-sm font-bold text-forest-teal no-underline hover:underline">
          Read the full bio on the About page &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== COMMUNITY & FAITH ==================== -->
  <section class="bg-pale-sage py-24 md:py-32" id="community">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionHeading title="Community & Faith" subtitle="The work that gives everything else meaning" accent="rose" />

      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-start">
          <div class="space-y-6 text-lg leading-relaxed text-warm-umber">
            <p>
              Every week I teach. At the Muslim Association of Puget Sound (MAPS) in Redmond, I speak and lead educational sessions on faith, resilience, civic engagement, and personal development. At the Islamic Center of Bothell, I run a series called <em>Weekly Knowledge Quest</em> &mdash; a running conversation with community members on the questions that matter.
            </p>
            <p>
              I'm also a member of the Bellevue Rotary Club, where business meets service and the coffee is strong enough to keep you honest.
            </p>
          </div>
          <div class="space-y-6 text-lg leading-relaxed text-warm-umber">
            <p>
              These aren't side projects. They're the other half of the life. The tech career gives me a platform and a paycheck; the teaching keeps me humble and keeps me learning. Faith, for me, is less a statement and more a practice of showing up &mdash; for students, for neighbors, for the next honest conversation.
            </p>
            <p>
              If you're in the Seattle area and want to sit in on a session, reach out. The door is open.
            </p>
          </div>
        </div>

        <!-- Community orgs strip -->
        <div class="mt-14 grid sm:grid-cols-3 gap-4">
          <div class="bg-warm-white rounded-2xl p-6 border border-warm-blush/50 text-center">
            <p class="font-fraunces text-lg text-deep-brown mb-1">MAPS</p>
            <p class="font-caveat text-lg text-burnt-sienna mb-2">Redmond, WA</p>
            <p class="text-sm text-warm-umber">Weekly teacher &amp; speaker at the Muslim Association of Puget Sound.</p>
          </div>
          <div class="bg-warm-white rounded-2xl p-6 border border-warm-blush/50 text-center">
            <p class="font-fraunces text-lg text-deep-brown mb-1">Islamic Center of Bothell</p>
            <p class="font-caveat text-lg text-forest-teal mb-2">Weekly Knowledge Quest</p>
            <p class="text-sm text-warm-umber">An ongoing educational series on faith and life in practice.</p>
          </div>
          <div class="bg-warm-white rounded-2xl p-6 border border-warm-blush/50 text-center">
            <p class="font-fraunces text-lg text-deep-brown mb-1">Bellevue Rotary</p>
            <p class="font-caveat text-lg text-marigold mb-2">Service above self</p>
            <p class="text-sm text-warm-umber">Member and occasional speaker on technology &amp; customer success.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SPEAKING & MEDIA ==================== -->
  <section class="bg-warm-white py-24 md:py-32" id="speaking">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionHeading title="Speaking & Writing" subtitle="Where the ideas have been sharpened in public" accent="marigold" />

      <div class="max-w-4xl mx-auto">
        <ul class="space-y-6">
          {speaking.map((item) => (
            <li class="group border-b border-warm-blush/50 pb-6 last:border-none">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-2">
                <span class={`px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wide ${accentBg[item.accent as keyof typeof accentBg]}/15 ${accentText[item.accent as keyof typeof accentText]}`}>
                  {item.date}
                </span>
                <span class="font-lato text-sm text-warm-umber/70">{item.venue}</span>
              </div>
              <h3 class="font-fraunces text-xl md:text-2xl text-deep-brown leading-snug">{item.title}</h3>
            </li>
          ))}
        </ul>

        <div class="mt-12 bg-peach-cream/40 rounded-3xl p-8 md:p-10 border border-warm-blush/60 text-center">
          <p class="font-caveat text-2xl text-burnt-sienna mb-2">Booking &amp; media</p>
          <p class="text-warm-umber text-sm max-w-2xl mx-auto">
            Open to keynotes, panels, and podcast conversations on customer success, AI-as-a-Service, cloud transformation, and leading teams across cultures. The best way to reach me is via <a href="https://www.linkedin.com/in/alaa-badr-" class="text-forest-teal">LinkedIn</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CONNECT ==================== -->
  <section class="bg-gradient-to-b from-peach-cream/50 to-pale-sage py-24 md:py-32" id="connect">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <SectionHeading title="Let's Connect" subtitle="The kettle is always on" accent="teal" />

      <p class="text-lg text-warm-umber leading-relaxed max-w-2xl mx-auto mb-10">
        Whether you want to talk customer success, cloud strategy, community work, or the subtle differences between Cairo and Seattle coffee &mdash; my inbox and my LinkedIn are both open.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 mb-10">
        <a href="https://www.linkedin.com/in/alaa-badr-" class="inline-block px-6 py-3 bg-forest-teal text-warm-white rounded-full font-lato font-bold text-sm no-underline hover:bg-forest-teal/90 transition-colors">
          Connect on LinkedIn
        </a>
        <a href="https://x.com/alaabaadr" class="inline-block px-6 py-3 bg-burnt-sienna text-warm-white rounded-full font-lato font-bold text-sm no-underline hover:bg-burnt-sienna/90 transition-colors">
          Follow on X
        </a>
        <a href="/about/" class="inline-block px-6 py-3 bg-deep-brown text-warm-white rounded-full font-lato font-bold text-sm no-underline hover:bg-deep-brown/80 transition-colors">
          Read the Full Bio
        </a>
      </div>

      <p class="font-caveat text-2xl text-warm-umber">
        Thanks for scrolling all the way down. See you out there.
      </p>
    </div>
  </section>
</BaseLayout>
