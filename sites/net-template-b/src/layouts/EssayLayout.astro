---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date?: Date;
  updated?: Date;
  tags?: string[];
  category?: string;
  image?: string;
  /** Optional caption / credit rendered under the hero image (HTML allowed). */
  imageCredit?: string;
  backHref?: string;
  backLabel?: string;
  eyebrow?: string;
}

const {
  title,
  description,
  date,
  updated,
  tags = [],
  category,
  image,
  imageCredit,
  backHref = '/writing',
  backLabel = 'Back to all writing',
  eyebrow,
} = Astro.props;

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const headerLabel = eyebrow ?? category;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={image}
  publishedDate={date ? date.toISOString() : undefined}
>
  <article class="h-entry bg-warm-white">
    <!-- Hero -->
    <header class="bg-gradient-to-b from-peach-cream/60 to-warm-white border-b border-warm-blush/60 py-20 md:py-28">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        {headerLabel && (
          <p class="font-caveat text-2xl text-burnt-sienna mb-3 p-category">{headerLabel}</p>
        )}
        <h1 class="p-name font-fraunces text-4xl md:text-5xl lg:text-6xl text-deep-brown mb-6 leading-[1.1]">
          {title}
        </h1>
        <p class="p-summary text-lg md:text-xl text-warm-umber leading-relaxed max-w-2xl">
          {description}
        </p>
        {date && (
          <p class="mt-6 text-sm font-lato text-warm-umber/80">
            <time class="dt-published" datetime={date.toISOString()}>{dateFmt.format(date)}</time>
            {updated && (
              <>
                {' · Updated '}
                <time class="dt-updated" datetime={updated.toISOString()}>{dateFmt.format(updated)}</time>
              </>
            )}
          </p>
        )}
      </div>
    </header>

    {image && (
      <div class="bg-warm-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-8 md:-mt-12 flex flex-col items-center">
          <img
            src={image}
            alt={title}
            loading="eager"
            decoding="async"
            class="u-photo rounded-2xl shadow-md w-auto max-w-full max-h-[640px] object-contain"
          />
          {imageCredit && (
            <p class="font-lato text-xs text-warm-umber/70 mt-3 text-center italic max-w-2xl" set:html={imageCredit}></p>
          )}
        </div>
      </div>
    )}

    <!-- Body -->
    <div class="py-16 md:py-20">
      <div class="e-content max-w-prose mx-auto px-4 sm:px-6 prose-essay text-lg leading-[1.8] text-warm-umber">
        <slot />
      </div>

      {tags.length > 0 && (
        <div class="max-w-prose mx-auto px-4 sm:px-6 mt-12 pt-8 border-t border-warm-blush/60">
          <p class="text-sm font-lato text-warm-umber/80 mb-3">Tags</p>
          <div class="flex flex-wrap gap-2">
            {tags.map((t) => (
              <span class="p-category inline-block px-3 py-1 rounded-full text-xs font-lato font-bold bg-peach-cream text-burnt-sienna border border-warm-blush/60">
                #{t}
              </span>
            ))}
          </div>
        </div>
      )}

      <div class="max-w-prose mx-auto px-4 sm:px-6 mt-12">
        <a href={backHref} class="font-caveat text-xl text-forest-teal no-underline">
          &larr; {backLabel}
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose-essay p {
    margin-bottom: 1.4em;
  }
  .prose-essay h2 {
    @apply font-fraunces text-3xl text-deep-brown mt-12 mb-4;
  }
  .prose-essay h3 {
    @apply font-fraunces text-2xl text-deep-brown mt-10 mb-3;
  }
  .prose-essay blockquote {
    @apply font-caveat text-2xl text-burnt-sienna border-l-4 border-burnt-sienna/30 pl-5 my-8;
  }
  .prose-essay a {
    @apply text-forest-teal underline decoration-warm-blush;
  }
  .prose-essay ul,
  .prose-essay ol {
    margin-left: 1.5em;
    margin-bottom: 1.4em;
  }
  .prose-essay li {
    margin-bottom: 0.4em;
  }
  .prose-essay code {
    @apply bg-peach-cream/80 rounded px-1.5 py-0.5 text-sm;
    font-family: ui-monospace, monospace;
  }
  .prose-essay img {
    @apply w-full rounded-2xl shadow-sm my-8;
  }
  .prose-essay figure {
    @apply my-10;
  }
  .prose-essay figure img {
    @apply my-0;
  }
  .prose-essay figcaption {
    @apply font-lato text-sm text-warm-umber/70 mt-3 text-center italic;
  }
  .prose-essay figcaption a {
    @apply text-warm-umber/70 underline decoration-warm-blush/60;
  }
</style>
