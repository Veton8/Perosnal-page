---
interface Props {
  title: string;
  subtitle?: string;
  accent?: 'sienna' | 'teal' | 'rose' | 'marigold';
  id?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, accent = 'sienna', id, align = 'center' } = Astro.props;

const accentColors: Record<string, string> = {
  sienna: 'bg-burnt-sienna',
  teal: 'bg-forest-teal',
  rose: 'bg-dusty-rose',
  marigold: 'bg-marigold',
};

const dividerColor = accentColors[accent];
const alignClass = align === 'center' ? 'text-center' : 'text-left';
const dividerAlign = align === 'center' ? 'mx-auto' : '';
---

<div class={`mb-12 md:mb-16 ${alignClass}`} id={id}>
  <h2 class="font-fraunces text-3xl md:text-4xl lg:text-5xl text-deep-brown mb-3 leading-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="font-caveat text-2xl md:text-3xl text-warm-umber mb-4">
      {subtitle}
    </p>
  )}
  <div class={`w-16 h-1 rounded-full ${dividerColor} ${dividerAlign}`}></div>
</div>
